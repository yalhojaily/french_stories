# انسخ هذا الملف باسم .env (بدون .example) ثم ضع قيمك
# لا ترفع ملف .env إلى أي مكان عام: فيه مفتاحك السري

# مفتاح ElevenLabs: من موقعهم ← Profile ← API Keys
ELEVENLABS_API_KEY=ضع_مفتاحك_هنا

# معرّف الصوت: شغّل  python tools/build.py --voices  لعرض الأصوات في حسابك
ELEVENLABS_VOICE_ID=

# اختياري
ELEVENLABS_MODEL=eleven_multilingual_v2
# سرعة القراءة (0.7 إلى 1.2). للمبتدئين 0.9 مناسبة
ELEVENLABS_SPEED=0.9
